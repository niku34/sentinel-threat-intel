# Sentinel Environment Configuration
# Copy this file to api/.env and fill in your values

# Database
DATABASE_URL=postgresql://sentinel_app:YOUR_PASSWORD@localhost:5432/sentinel

# Security
JWT_SECRET_KEY=your-secret-key-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Encryption (used by pgcrypto for email/MFA fields)
APP_ENCRYPTION_KEY=your-pgcrypto-encryption-key-min-32-chars

# Ollama (local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b

# Ollama Security (set after configuring Nginx reverse proxy — see infrastructure/README-security.md)
# Leave empty for local dev. After Nginx setup: set to your token and change OLLAMA_BASE_URL to port 11435.
OLLAMA_BEARER_TOKEN=

# YouTube API (get from console.cloud.google.com)
YOUTUBE_API_KEY=

# Meta / Facebook (enter via Admin Console — do not put here)
# META credentials are stored in platform_config table, not in .env

# Google Vision (optional — PIL fallback used if not set)
GOOGLE_APPLICATION_CREDENTIALS=

# Archive Storage
ARCHIVE_STORAGE_PATH=/mnt/archive

# Server
API_HOST=0.0.0.0
API_PORT=8000
DASHBOARD_PORT=3000

# CERT-In Reporting
CERTIN_CONTACT_EMAIL=contact@example.com
CERTIN_ORGANISATION=Example Broadcaster Ltd
CERTIN_REPORTING_EMAIL=incident@cert-in.org.in
CERTIN_DEADLINE_HOURS=6
CERTIN_REFERENCE_PREFIX=JS-CERTIN
